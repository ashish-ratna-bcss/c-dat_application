[Unit]
Description=CDR Import Microservice (CDAT)
After=network.target postgresql.service

[Service]
Type=simple
User=hyd-cat
WorkingDirectory=/mnt/storage1/cdat-web/cdr-import-service
Environment=PYTHONPATH=/mnt/storage1/cdat-web
Environment=CDR_API_HOST=127.0.0.1
Environment=CDR_API_PORT=8088
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 127.0.0.1 --port 8088
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
