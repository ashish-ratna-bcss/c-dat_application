# Copy to .env. PHP and Python both load this file.
# Change these names if your PostgreSQL databases use different names.

CDR_DB_HOST=127.0.0.1
CDR_DB_PORT=5432
CDR_DB_NAME=CDATDUPL_DB
CDR_DB_USER=postgres
CDR_DB_PASSWORD=your_password_here

IR_DB_NAME=IR_DB
JRMS_DB_NAME=JRMS_DB
PDACT_DB_NAME=PDACT_DB
ROWDY_SHEETS_DB_NAME=ROWDY_SHEETS_DB
TRAINING_DB_NAME=TRAINING_DB

# Staging schema for CDR row tables (inside CDR_DB_NAME)
CDAT_PCSUSPECT_SCHEMA=cdatpcsuspectstagingdb
# Jobs + upload history (inside CDR_DB_NAME)
CDAT_UPLOAD_SCHEMA=cdatupload

# Local API (./deploy/dev.sh uses 8090 if these are unset)
# DATA_UPLOAD_HOST=127.0.0.1
# DATA_UPLOAD_PORT=8090
# DATA_UPLOAD_URL=http://127.0.0.1:8090
# DATA_UPLOAD_LOG_DIR=logs

# Production (./deploy/prod.sh + PM2)
# PHP_HOST=0.0.0.0
# PHP_PORT=8022
# DATA_UPLOAD_HOST=0.0.0.0
# DATA_UPLOAD_PORT=5022
# DATA_UPLOAD_URL=http://SERVER_IP:5022

# Security (optional)
# CDAT_SQL_CONSOLE=0
# CDAT_SESSION_IDLE_MINUTES=30
# CDAT_LOGIN_MAX_ATTEMPTS=5
# CDAT_LOGIN_LOCKOUT_MINUTES=15
# CDAT_SQL_CONSOLE_MAX_ROWS=10000
# CDAT_SQL_CONSOLE_TIMEOUT_MS=60000
