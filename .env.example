# Copy to .env and configure for your environment.
# bootstrap/env.php and db_config.php load these automatically.

CDR_DB_HOST=127.0.0.1
CDR_DB_PORT=5432
CDR_DB_NAME=postgres
CDR_DB_USER=postgres
CDR_DB_PASSWORD=your_password_here

# Document / Python API (required in production).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CDR_API_KEY=change_me_to_a_long_random_secret
CDR_API_URL=http://127.0.0.1:8088
CDR_API_PUBLIC_URL=/document-api
# Local-only escape hatch (never enable in production):
# CDR_API_ALLOW_ANONYMOUS=1
# Bind: leave unset for 127.0.0.1 (nginx proxies). Do not use 0.0.0.0 in prod.
# CDR_API_HOST=127.0.0.1
# CDR_API_PORT=8088
# Parallel background import workers (different uploads run concurrently).
# CDR_IMPORT_WORKERS=8

# Optional: expose DB error text on /health.php
# CDAT_DEBUG=1
