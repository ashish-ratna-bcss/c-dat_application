[Unit]
Description=CDAT distributed_db reference indexes (address, cellids geo/tower)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=hyd-cat
WorkingDirectory=/mnt/storage1/cdat-web
TimeoutStartSec=0
Nice=10
ExecStart=/mnt/storage1/cdat-web/scripts/build_distributed_reference_indexes.sh
RemainAfterExit=yes
StandardOutput=append:/tmp/cdat_distributed_indexes.log
StandardError=append:/tmp/cdat_distributed_indexes.log

[Install]
WantedBy=multi-user.target
