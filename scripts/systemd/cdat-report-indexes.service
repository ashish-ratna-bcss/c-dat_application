[Unit]
Description=CDAT cdatpcsuspect report indexes (phone+starttime, other, celltowerid)
After=network.target postgresql.service cdat-dedup-index.service
Wants=postgresql.service cdat-dedup-index.service

[Service]
Type=oneshot
User=hyd-cat
WorkingDirectory=/mnt/storage1/cdat-web
TimeoutStartSec=0
Nice=10
ExecStart=/mnt/storage1/cdat-web/scripts/build_report_indexes.sh
RemainAfterExit=yes
StandardOutput=append:/tmp/cdat_report_indexes.log
StandardError=append:/tmp/cdat_report_indexes.log

[Install]
WantedBy=multi-user.target
