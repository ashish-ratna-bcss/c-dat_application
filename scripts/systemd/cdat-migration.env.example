# CDAT migration / background-job credentials.
#
# Copy this file to /etc/cdat/cdat-migration.env (referenced by the systemd units in
# this directory) and fill in the real values. Keep the deployed copy readable only by
# the service user, e.g.:
#
#   sudo install -d -m 0750 /etc/cdat
#   sudo install -m 0640 scripts/systemd/cdat-migration.env.example /etc/cdat/cdat-migration.env
#   sudoedit /etc/cdat/cdat-migration.env
#
# Never commit the populated file.

# MSSQL 'sa' password (source database for the migration).
MSSQL_SA_PASSWORD=

# PostgreSQL / distributed_db (Citus) password.
DIST_PG_PASSWORD=
