[Unit]
Description=CDAT document upload service (CDR/SDR FastAPI on 127.0.0.1:8088)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=hyd-cat
WorkingDirectory=/mnt/storage1/cdat-web
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/mnt/storage1/cdat-web
Environment=CDR_API_HOST=127.0.0.1
Environment=CDR_API_PORT=8088
Environment=CDR_STAGING_TABLE=cdatpcsuspect
ExecStart=/mnt/storage1/cdat-web/scripts/run_cdr_import_service.sh
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
