[Unit]
Description=CDAT full index pipeline (dedup → report indexes; distributed indexes in parallel)
After=network.target postgresql.service
Wants=postgresql.service cdat-distributed-indexes.service

[Service]
Type=oneshot
User=hyd-cat
WorkingDirectory=/mnt/storage1/cdat-web
TimeoutStartSec=0
# Distributed reference indexes can run alongside postgres dedup (different DB).
ExecStart=/bin/bash -c 'systemctl start --no-block cdat-distributed-indexes.service; systemctl start cdat-dedup-index.service; systemctl start cdat-report-indexes.service'
RemainAfterExit=yes
StandardOutput=append:/tmp/cdat_index_pipeline.log
StandardError=append:/tmp/cdat_index_pipeline.log

[Install]
WantedBy=multi-user.target
