[Unit]
Description=CDAT MSSQL migration key indexes (idx_cdat_sdr_key, idx_tower_key)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=hyd-cat
WorkingDirectory=/mnt/storage1/cdat-web
# Credentials (MSSQL_SA_PASSWORD) are provided via an untracked env file.
# See scripts/systemd/cdat-migration.env.example.
EnvironmentFile=-/etc/cdat/cdat-migration.env
Environment=DIST_MIGRATE_LOG_DIR=/mnt/storage1/ITCell_DL_RTA_Data/distributed_migrate_logs
ExecStart=/mnt/storage1/cdat-web/scripts/ensure_mssql_migration_indexes.sh
Restart=on-failure
RestartSec=30
Nice=10

[Install]
WantedBy=multi-user.target
