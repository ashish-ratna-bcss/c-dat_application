# 1) In /etc/nginx/sites-available/cdat-web, replace `location ~ \.php$` with:
#
#   sudo nginx -t && sudo systemctl reload nginx
#
# 2) In /etc/php/8.3/fpm/pool.d/www.conf, extend security.limit_extensions:
#
#   security.limit_extensions = .php .PHP .php3 .php4 .php5 .php7 .html .htm .HTML .HTM
#
#   sudo systemctl reload php8.3-fpm
#
# Without step 2, lowercase .html URLs return "Access denied." from PHP-FPM.

    location ~ (?i)\.(php|html|htm)$ {
        include fastcgi.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_read_timeout 86400s;
        fastcgi_send_timeout 86400s;
        fastcgi_connect_timeout 10s;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
        fastcgi_param PHP_VALUE "auto_prepend_file=/mnt/storage1/cdat-web/sqlsrv_compat.php \n memory_limit=512M \n max_execution_time=86400";
    }
