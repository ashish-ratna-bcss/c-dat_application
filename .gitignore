# keep it that way.
*.csv
*.xls
*.xlsx

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Dependencies (if added later)
vendor/
node_modules/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# Backup and temp files
*.bak
*.save
*.tmp
